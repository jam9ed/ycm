# Dependencies and scratch
node_modules/
.DS_Store

# Source archives of the old Wix site — big, and only ever inputs
*.webarchive
existing site/

# Local admin state and its rolling backups
assets/data/backups/
assets/data/ads-config.json.tmp

# Media: only what the site actually references is tracked. The full library
# (900+ files, ~130 MB) lives locally so the admin gallery has everything to
# choose from; the repo carries the ~170 files that are linked to an ad, used
# by a blog post, or referenced in code. Re-fetch the rest with the scripts in
# the README if you need the whole pool on another machine.

assets/img/lib/*
!assets/img/lib/40c803ad1c.jpg
!assets/img/lib/e2254316fa.jpg
!assets/img/lib/fcfc0234f1.jpg
!assets/img/lib/fe864993aa.jpg

assets/img/boats/*
!assets/img/boats/src_0f12e59d2f.jpg
!assets/img/boats/src_e7268cdd12.jpg

# Poster frames are all tracked now: videos.html is a contact sheet of the whole
# reel, so every one of the 94 is referenced by code. 7.6 MB, worth it.
!assets/img/posters/*.jpg

# The previous hero reel — the centre-weighted cut — is kept locally so it can
# be dropped back in by swapping the paths in v3.html's data-hero-reel. It is
# also preserved exactly in git history at commit a5f29de, so it is not carried
# a second time here.
assets/video/hero-centered/
assets/img/hero-centered/

# Full-length source videos stay on Wix — they are 231 MB and we only ever
# wanted ten seconds of them. The trimmed hero loop is tracked.
assets/video/*
!assets/video/hero/

# Build product of tools/framedump.swift — rebuild with the line in its header.
tools/framedump
